{
  "name": "tilda-mcp",
  "version": "0.2.0-prealpha",
  "private": false,
  "description": "Pre-alpha MCP control plane for verified, reversible Tilda lab operations.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:security": "vitest run tests/security",
    "mcp": "tsx src/mcp/index.ts",
    "mcp:built": "node dist/src/mcp/index.js",
    "smoke:mcp": "tsx scripts/mcp-stdio-smoke.ts",
    "tilda": "tsx src/research/cli.ts",
    "observatory": "tsx src/research/server.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
