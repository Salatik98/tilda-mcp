TILDA_CDP_URL=http://127.0.0.1:9222
OBSERVATORY_HOST=127.0.0.1
OBSERVATORY_PORT=4765

# Optional official Tilda API credentials. Never commit real values.
TILDA_PUBLIC_KEY=
TILDA_SECRET_KEY=

# Fail closed. Populate only in an ignored local .env after a complete,
# authorized inventory and an explicit lab classification.
TILDA_ACCOUNT_FINGERPRINT=UNSPECIFIED
TILDA_INVENTORY_HASH=UNSPECIFIED
LAB_PROJECT_IDS=UNSPECIFIED
READ_ONLY_PROJECT_IDS=UNSPECIFIED
LAB_PAGE_TARGETS=UNSPECIFIED
PUBLIC_TEST_DOMAINS=UNSPECIFIED
