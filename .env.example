TILDA_CDP_URL=http://127.0.0.1:9222
# Local HMAC key; generated only by `pnpm tilda bind` and ignored by Git.
TILDA_BINDING_KEY_PATH=.tilda-runtime/account-binding.key
# Local digest state; `bind --persist` writes it without rewriting .env secrets.
TILDA_BINDING_STATE_PATH=.tilda-runtime/account-binding.json
OBSERVATORY_HOST=127.0.0.1
OBSERVATORY_PORT=4765

# Optional. Business plan only. Never commit real values.
TILDA_PUBLIC_KEY=
TILDA_SECRET_KEY=

# A public checkout has no account-specific source ledger. Build and review a
# local, ignored read-only inventory before enabling any write allowlist.
TILDA_ACCOUNT_FINGERPRINT=UNSPECIFIED
TILDA_INVENTORY_HASH=UNSPECIFIED
LAB_PROJECT_IDS=UNSPECIFIED
READ_ONLY_PROJECT_IDS=UNSPECIFIED
# Exact projectId:pageId pairs only. A page ID is never globally reusable across projects.
LAB_PAGE_TARGETS=UNSPECIFIED
# Exact projectId:pageId:recordId triples only. This ignored local admission is
# empty until an EXP-06 create+reread is explicitly selected as an EXP-05 fixture.
LAB_RECORD_TARGETS=UNSPECIFIED
PUBLIC_TEST_DOMAINS=UNSPECIFIED
